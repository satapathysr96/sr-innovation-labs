---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Home">
  <Navbar />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative py-24 sm:py-32 overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(34,197,94,0.15),rgba(255,255,255,0))]"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-500 text-xs font-semibold uppercase tracking-wider mb-8">
            <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
            Modern Web Engineering Studio
          </div>

          <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight mb-6">
            We Build Web Applications That <span class="bg-gradient-to-r from-brand-500 via-emerald-400 to-teal-300 bg-clip-text text-transparent">Grow Your Business.</span>
          </h1>

          <p class="text-lg text-gray-400 mb-10 leading-relaxed">
            High-speed websites, custom React applications, and automated Google Business setups designed specifically for ambitious local enterprises and coaching centers.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/templates"
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-brand-500 text-black font-bold hover:bg-brand-600 transition-all shadow-lg shadow-brand-500/20 text-center"
            >
              Explore Template Demos
            </a>
            <a
              href="/contact"
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-dark-card border border-dark-border text-white font-semibold hover:border-gray-600 transition-colors text-center"
            >
              Request Custom Build
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-20 bg-dark-card/50 border-y border-dark-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-white mb-4">What We Deliver</h2>
          <p class="text-gray-400 max-w-xl mx-auto">Full-stack web engineering combined with modern local business optimization.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Service 1 -->
          <div class="p-8 rounded-2xl bg-dark-card border border-dark-border hover:border-brand-500/50 transition-colors">
            <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center mb-6 font-bold text-xl">
              01
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Custom Web Apps</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Ultra-fast websites built using Astro and React. Zero lag, 100/100 Lighthouse performance, and built-in mobile optimization.
            </p>
          </div>

          <!-- Service 2 -->
          <div class="p-8 rounded-2xl bg-dark-card border border-dark-border hover:border-brand-500/50 transition-colors">
            <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center mb-6 font-bold text-xl">
              02
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Turnkey Industry Templates</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Pre-engineered, high-converting website layouts for Coaching Institutes, Healthcare Clinics, and Local Retail. Launch in days.
            </p>
          </div>

          <!-- Service 3 -->
          <div class="p-8 rounded-2xl bg-dark-card border border-dark-border hover:border-brand-500/50 transition-colors">
            <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center mb-6 font-bold text-xl">
              03
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Local SEO & Google Setup</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Google Maps integration, Google Business Profile configuration, and structured schema data so local customers find you first.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
