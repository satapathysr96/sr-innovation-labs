---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us">
  <Navbar />

  <main class="flex-grow py-16 max-w-3xl mx-auto px-4">
    <div class="bg-dark-card border border-dark-border p-8 sm:p-12 rounded-2xl">
      <h1 class="text-3xl font-extrabold text-white mb-2">Let's Build Your Digital Presence</h1>
      <p class="text-gray-400 text-sm mb-8">
        Have a project idea or need a template customized? Fill out the form below or chat with us directly on WhatsApp.
      </p>

      <form class="space-y-6">
        <div>
          <label class="block text-sm font-semibold text-gray-300 mb-2">Your Name</label>
          <input
            type="text"
            required
            placeholder="e.g. Soumya Satapathy"
            class="w-full px-4 py-3 rounded-xl bg-dark-bg border border-dark-border text-white focus:outline-none focus:border-brand-500"
          />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-300 mb-2">Business / Institute Name</label>
          <input
            type="text"
            required
            placeholder="e.g. Apex Coaching Classes"
            class="w-full px-4 py-3 rounded-xl bg-dark-bg border border-dark-border text-white focus:outline-none focus:border-brand-500"
          />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-300 mb-2">Message or Template Selected</label>
          <textarea
            rows="4"
            placeholder="Describe what you need..."
            class="w-full px-4 py-3 rounded-xl bg-dark-bg border border-dark-border text-white focus:outline-none focus:border-brand-500"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 rounded-xl bg-brand-500 text-black font-bold hover:bg-brand-600 transition-colors shadow-lg shadow-brand-500/20"
        >
          Send Inquiry
        </button>
      </form>

      <div class="mt-8 pt-8 border-t border-dark-border text-center">
        <p class="text-xs text-gray-500 mb-4">Prefer instant communication?</p>
        <a
          href="https://wa.me/910000000000?text=Hi%20SR%20Labs,%20I'd%20like%20to%20discuss%20a%20website%20project."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-600 text-white font-bold text-sm hover:bg-emerald-500 transition-colors"
        >
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
