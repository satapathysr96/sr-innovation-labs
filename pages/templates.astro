---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TemplateCatalog from '../components/TemplateCatalog';
---

<Layout title="Templates Catalog">
  <Navbar />

  <main class="flex-grow py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">
        Pre-Engineered Industry Templates
      </h1>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Pick a starting point tailored to your field. Every template comes fully integrated with Astro, custom React widgets, and local SEO configuration.
      </p>
    </div>

    {/* React Island */}
    <TemplateCatalog client:load />
  </main>

  <Footer />
</Layout>
